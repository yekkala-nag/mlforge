{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(platform)/layout,_N_T_/(platform)/from-scratch/layout,_N_T_/(platform)/from-scratch/page,_N_T_/from-scratch"
  },
  "segmentPaths": [

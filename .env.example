# =============================================================================
# ML Forge — Environment Configuration Template
# =============================================================================

# Server Port and Host
PORT=3000
HOSTNAME=0.0.0.0

# Optional: Next.js Telemetry (0 = disabled, 1 = enabled)
NEXT_TELEMETRY_DISABLED=1

# Optional Default LLM Provider Configuration (Users can also configure in-app via Settings UI)
# Supported providers: openai | anthropic | google | groq | together | mistral | deepseek | ollama | openrouter
NEXT_PUBLIC_DEFAULT_LLM_PROVIDER=openai
NEXT_PUBLIC_DEFAULT_LLM_MODEL=gpt-4o
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
